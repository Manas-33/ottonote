# Copy to .env and fill in values. Never commit .env.

# HuggingFace token (read scope). Required for pyannote diarization models.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Anthropic API key for Claude summarization.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model for summarization.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Whisper model size. Options: tiny, base, small, medium, large-v3, large-v3-turbo, distil-large-v3
# Apple Silicon dev default: "base" (fast). Production: "large-v3-turbo".
WHISPER_MODEL=base

# faster-whisper compute type. "int8" is fastest on CPU.
WHISPER_COMPUTE_TYPE=int8
