# Copy to .env and fill in values. Never commit .env.

# HuggingFace token (read scope). Required for pyannote diarization models.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Anthropic API key for Claude summarization.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model for summarization.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Whisper model size. Options: tiny, base, small, medium, large-v3, large-v3-turbo, distil-large-v3
# Apple Silicon dev default: "base" (fast). Production: "large-v3-turbo".
WHISPER_MODEL=base

# faster-whisper compute type. "int8" is fastest on CPU.
WHISPER_COMPUTE_TYPE=int8

# --- Supabase ---
# From Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# From Project Settings -> Database -> Connection string -> "Session pooler" (port 5432).
# URL-encode special chars in password (# -> %23, @ -> %40, etc).
# Don't use the direct connection (db.xxx.supabase.co) — it's IPv6-only on free tier.
DATABASE_URL=

# Set to true ONLY for local dev. Exposes /transcribe and /process without auth.
DEV_MODE=false

# Redis URL for Celery broker + result backend.
REDIS_URL=redis://localhost:6379/0

# Supabase Storage bucket for uploaded audio. Created once via:
#   uv run python scripts/setup_storage.py
SUPABASE_STORAGE_BUCKET=meetings
